# Copy to deploy/.env.prod and fill in values.
#   cp deploy/.env.prod.example deploy/.env.prod

# --- PostgreSQL (docker internal) ---
POSTGRES_DB=minilangfuse
POSTGRES_USER=mlf
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-strong-password

# --- Public URL (must match your domain, used for CORS) ---
MLF_CORS_ORIGINS=https://YOUR_DOMAIN

# --- Host bind ports (localhost only; Nginx proxies to MLF_WEB_PORT) ---
MLF_WEB_PORT=8080
MLF_SERVER_PORT=8000
MLF_UVICORN_WORKERS=2

# --- LLM (Playground + Evaluators) — OpenAI-compatible ---
# DeepSeek example:
# MLF_OPENAI_API_KEY=sk-...
# MLF_OPENAI_BASE_URL=https://api.deepseek.com/v1
MLF_OPENAI_API_KEY=
MLF_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Anthropic
# MLF_ANTHROPIC_API_KEY=
