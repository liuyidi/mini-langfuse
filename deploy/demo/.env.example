# Copy to .env next to docker-compose.yml:
#   cp .env.example .env

# --- Sibling repo paths (relative to this deploy/demo directory) ---
# ECS layout /opt/demo/{mini-langfuse,minikb,nanobot} + minibot -> nanobot/minibot
MLF_DIR=../..
MINIKB_DIR=../../../minikb
MINIBOT_DIR=../../../minibot
NANOBOT_DIR=../../../nanobot

# Local mac layout example:
# MINIKB_DIR=/Users/you/ai/minikb
# MINIBOT_DIR=/Users/you/ai/nanobot/minibot
# NANOBOT_DIR=/Users/you/ai/nanobot

# --- Shared Postgres ---
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo-change-me

# --- LLM (DeepSeek / OpenAI-compatible) — shared by all three apps ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
MINIBOT_MODEL=deepseek-chat

# --- mini-langfuse CORS (browser origins that open the UI) ---
# Example for liuyidi.me:
MLF_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,https://liuyidi.me,https://www.liuyidi.me,https://mlf.liuyidi.me,https://bot.liuyidi.me

# Demo keys (replace after first login if you create a real project)
LANGFUSE_PUBLIC_KEY=pk-lf-demo
LANGFUSE_SECRET_KEY=sk-lf-demo

# --- MinIO (only with --profile kb|full) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# minikb: use "dev" so init_db can create tables on first boot
MINIKB_ENV=dev

# minibot → minikb (compose service DNS). Leave empty to disable kb_* tools.
# MINIBOT_MINIKB_BASE_URL=http://minikb:8080
# MINIBOT_MINIKB_API_KEY=
# MINIBOT_MINIKB_UI_URL=https://kb.liuyidi.me/ui/
