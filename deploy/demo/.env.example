# Copy to .env next to docker-compose.yml:
#   cp .env.example .env

# --- Sibling repo paths (relative to this deploy/demo directory) ---
# ECS layout: /opt/demo/{mini-langfuse,minikb,minibot}
# MINIBOT_REPO_DIR = monorepo root (Dockerfile.minibot + webui/ + minibot/)
MLF_DIR=../..
MINIKB_DIR=../../../minikb
MINIBOT_REPO_DIR=../../../minibot

# Local mac layout example:
# MINIKB_DIR=/Users/you/github/minikb
# MINIBOT_REPO_DIR=/Users/you/github/minibot

# Download page release manifesto (baked into WebUI at image build time).
VITE_MINIBOT_RELEASES_URL=https://downloads.liuyidi.me/minibot/releases.json

# --- Shared Postgres ---
POSTGRES_USER=demo
POSTGRES_PASSWORD=demo-change-me

# --- LLM (DeepSeek / OpenAI-compatible) — shared by all three apps ---
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
MINIBOT_MODEL=deepseek-v4-flash

# Optional: paste platform slots from minibot/.env.models (or merge-env.sh output).
# Compose forwards MINIBOT_SERVER_{SLOT}_* into demo-minibot.
# MINIBOT_SERVER_DEEPSEEK_PRO_API_KEY=
# MINIBOT_SERVER_QWEN_API_KEY=
# MINIBOT_SERVER_GLM_API_KEY=
# MINIBOT_SERVER_KIMI_API_KEY=
# MINIBOT_SERVER_MINIMAX_API_KEY=
# MINIBOT_SERVER_DOUBAO_API_KEY=
# MINIBOT_SERVER_DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/coding
# MINIBOT_SERVER_DOUBAO_MODEL=doubao-seed-2.0-lite

# --- mini-langfuse CORS (browser origins that open the UI) ---
# Example for liuyidi.me:
MLF_CORS_ORIGINS=http://127.0.0.1:8080,http://localhost:8080,https://liuyidi.me,https://www.liuyidi.me,https://mlf.liuyidi.me,https://bot.liuyidi.me

# Demo keys (replace after first login if you create a real project)
LANGFUSE_PUBLIC_KEY=pk-lf-demo
LANGFUSE_SECRET_KEY=sk-lf-demo

# --- MinIO (only with --profile kb|full) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# minikb: use "dev" so init_db can create tables on first boot
MINIKB_ENV=dev

# minibot → minikb (compose service DNS). Leave empty to disable kb_* tools.
# MINIBOT_MINIKB_BASE_URL=http://minikb:8080
# MINIBOT_MINIKB_API_KEY=
# MINIBOT_MINIKB_UI_URL=https://kb.liuyidi.me/ui/

# minibot daily LLM budget (UTC). 0 = unlimited for that dimension.
MINIBOT_DAILY_TURN_LIMIT=200
MINIBOT_DAILY_TOKEN_LIMIT=2000000

# exec sandbox: local (default) or e2b — keep local on ECS unless you opt in
# MINIBOT_EXEC_BACKEND=e2b
# E2B_API_KEY=
