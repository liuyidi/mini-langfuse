# Production env for deploy/docker-compose.yml (Tencent / mlf.liuyidi.me).
# Local development uses the repo-root .env.example instead — do not mix them.
#
#   cp deploy/.env.example deploy/.env
# Hosts that still have deploy/.env.prod: ./deploy/up.sh will use it until you rename.

# --- PostgreSQL (docker internal) ---
POSTGRES_DB=minilangfuse
POSTGRES_USER=mlf
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-strong-password

# --- Public URL (must match the browser origin, used for CORS) ---
MLF_CORS_ORIGINS=https://mlf.liuyidi.me

# --- Host bind ports (localhost only; Nginx proxies to MLF_WEB_PORT) ---
MLF_WEB_PORT=8080
MLF_SERVER_PORT=8000
MLF_UVICORN_WORKERS=2

# --- LLM (Playground + Evaluators) — OpenAI-compatible ---
# DeepSeek example:
# MLF_OPENAI_API_KEY=sk-...
# MLF_OPENAI_BASE_URL=https://api.deepseek.com/v1
MLF_OPENAI_API_KEY=
MLF_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Anthropic
# MLF_ANTHROPIC_API_KEY=
