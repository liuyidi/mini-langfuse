# Mini-Langfuse Environment Configuration
# Copy this file to .env and adjust values as needed

# =============================================================================
# Database Configuration
# =============================================================================
# PostgreSQL (recommended for production):
MLF_DATABASE_URL=postgresql+psycopg://mlf:mlf@localhost:5432/minilangfuse

# SQLite (for local development):
# MLF_DATABASE_URL=sqlite:///./mini_langfuse.db

# =============================================================================
# Queue-first ingestion (Redis + ClickHouse)
# =============================================================================
# Leave empty to keep the legacy synchronous PostgreSQL ingestion path.
MLF_INGESTION_QUEUE_URL=
MLF_INGESTION_QUEUE_STREAM=mlf:ingestion
MLF_INGESTION_QUEUE_GROUP=mlf-worker
MLF_INGESTION_QUEUE_MAXLEN=100000

# ClickHouse read path
MLF_CLICKHOUSE_URL=http://localhost:8123
MLF_CLICKHOUSE_DATABASE=default
MLF_CLICKHOUSE_USER=default
MLF_CLICKHOUSE_PASSWORD=

# Worker-side defaults (only used by the worker process)
MLF_WORKER_MODE=redis
MLF_REDIS_URL=redis://localhost:6379/0
MLF_REDIS_STREAM=mlf:ingestion
MLF_REDIS_GROUP=mlf-worker
MLF_REDIS_CONSUMER=worker-1
MLF_CLICKHOUSE_URL=http://localhost:8123
MLF_CLICKHOUSE_DATABASE=default
MLF_CLICKHOUSE_USER=default
MLF_CLICKHOUSE_PASSWORD=
MLF_WORKER_BATCH_SIZE=100

# =============================================================================
# Authentication (M1: demo mode)
# =============================================================================
MLF_AUTH_PUBLIC_KEY=pk-lf-demo
MLF_AUTH_SECRET_KEY=sk-lf-demo
MLF_DEMO_PROJECT_ID=proj_demo

# =============================================================================
# CORS Origins (comma-separated)
# =============================================================================
MLF_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# =============================================================================
# LLM Provider Keys (for Playground M8)
# =============================================================================
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-...
