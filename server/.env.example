# Absolute SQLite path recommended
# MLF_DATABASE_URL=sqlite:////absolute/path/to/mini_langfuse.db

# Ingestion queue (Redis Streams)
# Leave empty to keep synchronous PostgreSQL writes.
MLF_INGESTION_QUEUE_URL=
MLF_INGESTION_QUEUE_STREAM=mlf:ingestion
MLF_INGESTION_QUEUE_GROUP=mlf-worker
MLF_INGESTION_QUEUE_MAXLEN=100000

# ClickHouse read path
MLF_CLICKHOUSE_URL=http://localhost:8123
MLF_CLICKHOUSE_DATABASE=default
MLF_CLICKHOUSE_USER=default
MLF_CLICKHOUSE_PASSWORD=

# LLM for Playground + Evaluation (OpenAI-compatible)
MLF_OPENAI_API_KEY=
# DeepSeek example: https://api.deepseek.com/v1
# Official OpenAI: https://api.openai.com/v1
MLF_OPENAI_BASE_URL=https://api.openai.com/v1

# Optional Anthropic
# MLF_ANTHROPIC_API_KEY=
